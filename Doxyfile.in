# ----------------------- Project -----------------------
PROJECT_NAME           = "SensorObserver"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
OUTPUT_LANGUAGE        = Russian

# ------------------------ Input ------------------------
INPUT                  = \
  "@CMAKE_SOURCE_DIR@/Common" \
  "@CMAKE_SOURCE_DIR@/Data" \
  "@CMAKE_SOURCE_DIR@/Exchange" \
  "@CMAKE_SOURCE_DIR@/Tools" \
  "@CMAKE_SOURCE_DIR@/Widgets" \
  "@CMAKE_SOURCE_DIR@/main.cpp" \
  "@CMAKE_SOURCE_DIR@/README.md"

FILE_PATTERNS          = *.h *.hpp *.hh *.c *.cc *.cpp *.md
RECURSIVE              = YES
EXCLUDE                = "@CMAKE_SOURCE_DIR@/Libs/QCustomPlot"
EXCLUDE_SYMBOLS        = Q* Qt*
EXCLUDE_PATTERNS       = */Qt*/** */qt*/** */Qt6*/** */Qt5*/** */usr/include/qt*/** */include/qt*/** */build/* */cmake-build-*/* *CMakeLists.txt.user

# Если хотите документировать и QCustomPlot — удалите EXCLUDE выше.

# --------------------- Extraction ----------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_METHODS  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
MULTILINE_CPP_IS_BRIEF = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = "@CMAKE_SOURCE_DIR@/README.md"

# -------------------- Preprocessing --------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = \
  Q_OBJECT \
  slots=public \
  signals=public \
  Q_SLOTS=public \
  Q_SIGNALS=public \
  emit=
PREDEFINED += DOXYGEN_SHOULD_SKIP_THIS

# ----------------------- HTML --------------------------
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
HTML_TIMESTAMP         = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ---------------------- Graphviz -----------------------
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
UML_LOOK               = YES
CLASS_DIAGRAMS         = YES
DOT_GRAPH_MAX_NODES    = 80
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

HIDE_UNDOC_RELATIONS = YES
SEARCH_INCLUDES      = NO

# -------------------- Parsing tweaks -------------------
CLANG_ASSISTED_PARSING = YES
CLANG_OPTIONS          =

